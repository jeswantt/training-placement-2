class Solution {
    Boolean[][] dp;
    public boolean canPartition(int[] nums) {
        int sum = 0;
        for (int num: nums) sum += num;
        if(sum % 2 == 1) return false;
        dp = new Boolean[nums.length][(sum/2)+1];
        
        return solve(nums,sum/2,nums.length -1);
    }
    public boolean solve(int nums[], int s,int idx){
        if (s == 0) return true;
        if(idx<0 || s< 0) return false;
        if(dp[idx][s] != null) return dp[idx][s];
        boolean take = solve(nums, s-nums[idx],idx-1);
        boolean skip = solve(nums, s, idx-1);
        return dp[idx][s] = take || skip;
    }
}
